    physique: {fileID: 21300000, guid: b830235e007530b4db5c4c7657dff53e, type: 3}
    magique: {fileID: 21300000, guid: bfc0d0cf520d9d24e81677be7a02fe9a, type: 3}
  degatsSlots:
  - {fileID: 1460155018}
  - {fileID: 1083832372}
  - {fileID: 52470257}
  degatsSpacing: 0.5
  typeDegatsIcon: {fileID: 0}
  allMonsters:
  - nom: La Larve
    proto_illu_desc: "Larve blanch\xE2tre gluante sortant de la terre, mandibules
      rongeuses."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_001
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: "Ce qui sort de la terre quand la corruption \xE9cl\xF4t."
    citation: "\xAB Ce qui sort de la terre quand la corruption \xE9cl\xF4t. \xBB"
    quantite: 2
  - nom: L'Essaim
    proto_illu_desc: "Nu\xE9e d'insectes et de chauves-souris noires tourbillonnant."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_002
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre est \xE9limin\xE9, piochez et placez-le
      en fond de file."
    description: Mille bouches pour une seule faim.
    citation: 
    quantite: 1
  - nom: La Spore
    proto_illu_desc: "Champignon pulsant lib\xE9rant des spores noires."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_003
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: "L\xE0 o\xF9 elle s'enracine, le sol meurt."
    citation: "\xAB L\xE0 o\xF9 elle s'enracine, le sol meurt. \xBB"
    quantite: 2
  - nom: Le Crochet
    proto_illu_desc: "Cr\xE9ature basse \xE0 long crochet osseux courbe, gueule dessous."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_004
    pv: 1
    degats: 2
    type_degats: 
    capacite_speciale: 
    description: "Il accroche, il tire, il d\xE9vore."
    citation: "\xAB Il accroche, il tire, il d\xE9vore. \xBB"
    quantite: 1
  - nom: La Dent
    proto_illu_desc: "Gueule autonome flottante, m\xE2choire h\xE9riss\xE9e de crocs."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_005
    pv: 1
    degats: 2
    type_degats: 
    capacite_speciale: 
    description: "Il n'a gard\xE9 que sa morsure."
    citation: "\xAB Il n'a gard\xE9 que sa morsure. \xBB"
    quantite: 1
  - nom: L'Aiguillon
    proto_illu_desc: "Insecte noir \xE0 dard courbe suintant un venin verd\xE2tre."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_006
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: "Une piq\xFBre suffit \xE0 pourrir le sang."
    citation: "\xAB Une piq\xFBre suffit \xE0 pourrir le sang. \xBB"
    quantite: 2
  - nom: "La M\xE2choire"
    proto_illu_desc: "Cr\xE9ature rampante, m\xE2choire \xE9norme tra\xEEnant sur
      le sol."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_007
    pv: 1
    degats: 2
    type_degats: 
    capacite_speciale: 
    description: "Elle tra\xEEne sa faim sur la terre."
    citation: "\xAB Elle tra\xEEne sa faim sur la terre. \xBB"
    quantite: 1
  - nom: Le Tesson
    proto_illu_desc: "Squelette de b\xEAte relev\xE9, os fendus vein\xE9s de corruption
      noire."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_008
    pv: 2
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: Les os des morts marchent encore.
    citation: "\xAB Les os des morts marchent encore. \xBB"
    quantite: 2
  - nom: La Carapace
    proto_illu_desc: "Cr\xE9ature \xE0 carapace \xE9paisse bomb\xE9e, corruption
      dans les fissures."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_009
    pv: 3
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre est \xE9limin\xE9, le h\xE9ros qui l'a tu\xE9
      pioche une <ico:chasse>."
    description: Sous la coque, plus rien qu'un nid de corruption.
    citation: 
    quantite: 1
  - nom: L'Ombre
    proto_illu_desc: "Silhouette de b\xEAte faite d'ombre liquide, yeux rouges flottants."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_010
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Tant que ce monstre n'est pas en t\xEAte de file, il ignore
      les <ico:degat> re\xE7ues ce tour."
    description: Elle a perdu son corps, mais pas sa rage.
    citation: 
    quantite: 1
  - nom: La Brume
    proto_illu_desc: "Nuage de brume noire en forme de b\xEAte, yeux jaunes."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_011
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre inflige des <ico:degat> \xE0 un h\xE9ros,
      ce h\xE9ros d\xE9fausse une carte de sa main."
    description: Elle entre par la bouche et s'installe.
    citation: 
    quantite: 1
  - nom: Le Murmure
    proto_illu_desc: "Cr\xE9ature fantomatique au visage partiel, glyphes sortant
      de la bouche."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_012
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre est \xE9limin\xE9, le h\xE9ros qui l'a tu\xE9
      pioche une <ico:destin>."
    description: "Les voix dans ta t\xEAte ne sont pas les tiennes."
    citation: 
    quantite: 1
  - nom: La Ronce
    proto_illu_desc: "Enchev\xEAtrement de ronces noires avec gueule v\xE9g\xE9tale
      au centre."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_013
    pv: 2
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: "L\xE0 o\xF9 elle pousse, plus rien ne marche."
    citation: "\xAB L\xE0 o\xF9 elle pousse, plus rien ne marche. \xBB"
    quantite: 2
  - nom: Le Limon
    proto_illu_desc: "Masse g\xE9latineuse noire visqueuse, ossements \xE0 demi-dig\xE9r\xE9s."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_014
    pv: 2
    degats: 1
    type_degats: 
    capacite_speciale: 
    description: "Il dig\xE8re lentement ce qui s'y prend."
    citation: "\xAB Il dig\xE8re lentement ce qui s'y prend. \xBB"
    quantite: 2
  - nom: Le Rampant
    proto_illu_desc: "Cr\xE9ature reptilienne allong\xE9e rampant au sol, \xE9cailles
      sombres."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_015
    pv: 2
    degats: 2
    type_degats: 
    capacite_speciale: "Quand ce monstre est \xE9limin\xE9, soignez le h\xE9ros qui
      l'a tu\xE9 de 1 <ico:degat>."
    description: Il suit ta trace depuis le premier jour.
    citation: 
    quantite: 1
  - nom: La Sangsue
    proto_illu_desc: "Sangsue g\xE9ante noire \xE0 ventouses, bouche circulaire dent\xE9e."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_016
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre inflige des <ico:degat> \xE0 un h\xE9ros,
      le colosse est soign\xE9 de 1 <ico:degat>."
    description: Elle boit pour lui.
    citation: 
    quantite: 1
  - nom: La Gangue
    proto_illu_desc: "Masse rocheuse fissur\xE9e, corruption pulsant comme du magma
      noir."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_017
    pv: 3
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre est \xE9limin\xE9, tous les h\xE9ros piochent
      1 <ico:chasse>."
    description: "Sous la cro\xFBte, quelque chose qui vaut la peine d'\xEAtre cass\xE9e."
    citation: 
    quantite: 1
  - nom: Le Bond
    proto_illu_desc: "Cr\xE9ature batracienne aux longues pattes arri\xE8re, pr\xEAte
      \xE0 bondir."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_018
    pv: 1
    degats: 2
    type_degats: 
    capacite_speciale: "Quand ce monstre arrive en jeu, il se place en t\xEAte de
      file."
    description: Il n'attend pas son tour.
    citation: 
    quantite: 1
  - nom: Le Reflux
    proto_illu_desc: "Cr\xE9ature serpentine recroquevill\xE9e, queue enroul\xE9e."
    sprite: {fileID: 0}
    offset: {x: 0, y: 2}
    scale: 0.5
    id: MON_019
    pv: 1
    degats: 1
    type_degats: 
    capacite_speciale: "Quand ce monstre doit attaquer, s'il n'est pas seul dans
      la file, il part en fond de file et le monstre suivant attaque \xE0 sa place."
    description: Il recule pour mieux revenir.
    citation: 
    quantite: 1
